{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssearch:updates:manifest:v1",
  "title": "ssearch signed update envelope v1",
  "description": "The envelope is limited to 262144 UTF-8 bytes. Decode payload_b64, verify its exact bytes using pinned CNG P-256 trust, then validate against #/$defs/payload. Runtime semantic checks and durable replay admission are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key_id", "payload_b64", "signature_b64"],
  "properties": {
    "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "payload_b64": {"type": "string", "contentEncoding": "base64", "maxLength": 262144},
    "signature_b64": {"type": "string", "contentEncoding": "base64", "minLength": 88, "maxLength": 88}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "description": "Canonical relative Windows-safe path using /. Runtime rejects device names, traversal, ADS, case collisions and file/directory prefix collisions."
    },
    "integer": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "version": {"type": "string", "maxLength": 40, "pattern": "^(0|[1-9][0-9]{0,8})(\\.(0|[1-9][0-9]{0,8})){1,3}$"},
    "api": {"type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["app", "desktop", "service", "service_api", "schema", "settings_schema", "postgres", "extension"],
      "properties": {
        "app": {"$ref": "#/$defs/version"}, "desktop": {"$ref": "#/$defs/version"},
        "service": {"$ref": "#/$defs/version"}, "service_api": {"$ref": "#/$defs/api"},
        "schema": {"$ref": "#/$defs/integer"}, "settings_schema": {"$ref": "#/$defs/integer"},
        "postgres": {"$ref": "#/$defs/version"}, "extension": {"$ref": "#/$defs/version"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["desktop", "service", "service_api", "schema_min", "schema_max", "settings_schema_min", "settings_schema_max"],
      "properties": {
        "desktop": {"$ref": "#/$defs/version"}, "service": {"$ref": "#/$defs/version"},
        "service_api": {"$ref": "#/$defs/api"},
        "schema_min": {"$ref": "#/$defs/integer"}, "schema_max": {"$ref": "#/$defs/integer"},
        "settings_schema_min": {"$ref": "#/$defs/integer"}, "settings_schema_max": {"$ref": "#/$defs/integer"}
      }
    },
    "executable": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "size", "sha256", "entry_count", "unpacked_bytes"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/path"},
        "size": {"type": "integer", "minimum": 0, "maximum": 4194304},
        "sha256": {"$ref": "#/$defs/hash"},
        "entry_count": {"type": "integer", "minimum": 0, "maximum": 20000},
        "unpacked_bytes": {"type": "integer", "minimum": 0, "maximum": 34359738368}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "relative_path", "size", "sha256", "kind", "format", "inventory"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "relative_path": {"$ref": "#/$defs/path"},
        "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "sha256": {"$ref": "#/$defs/hash"},
        "kind": {"enum": ["app", "schema", "postgres_minor", "extension", "postgres_major"]},
        "format": {"enum": ["file", "zip"]},
        "inventory": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/inventory"}]}
      },
      "allOf": [
        {"if": {"properties": {"format": {"const": "zip"}}}, "then": {"properties": {"inventory": {"$ref": "#/$defs/inventory"}}}},
        {"if": {"properties": {"format": {"const": "file"}}}, "then": {"properties": {"inventory": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "app"}}}, "then": {"properties": {"format": {"const": "zip"}}}}
      ]
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["format_version", "release_id", "source_commit", "sequence", "channel", "issued_at", "expires_at", "versions", "compatibility", "executables", "artifacts"],
      "properties": {
        "format_version": {"const": 1, "type": "integer"},
        "release_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "channel": {"enum": ["stable", "nightly"]},
        "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "versions": {"$ref": "#/$defs/versions"}, "compatibility": {"$ref": "#/$defs/compatibility"},
        "executables": {
          "type": "object", "additionalProperties": false, "required": ["desktop", "service"],
          "properties": {"desktop": {"$ref": "#/$defs/executable"}, "service": {"$ref": "#/$defs/executable"}}
        },
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  }
}
